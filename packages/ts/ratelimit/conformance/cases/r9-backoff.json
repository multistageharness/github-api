{
  "file": "r9-backoff",
  "description": "R9 — retry backoff is bounded and jittered. Three unjittered schedules exist in this repository today; synchronized retries from many clients rebuild the burst that caused the limit.",
  "cases": [
    {
      "id": "R9-001",
      "requirements": ["R9"],
      "title": "The first retry waits the base delay",
      "kind": "backoff",
      "input": { "attempt": 1, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "none" }, "random": 0.5 },
      "expect": { "delayMs": 1000 }
    },
    {
      "id": "R9-002",
      "requirements": ["R9"],
      "title": "Delay grows exponentially with the attempt",
      "kind": "backoff",
      "input": { "attempt": 3, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "none" }, "random": 0.5 },
      "expect": { "delayMs": 4000 }
    },
    {
      "id": "R9-003",
      "requirements": ["R9", "R6"],
      "title": "Growth is capped, so a long retry chain cannot run away",
      "kind": "backoff",
      "input": { "attempt": 10, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "none" }, "random": 0.5 },
      "expect": { "delayMs": 30000 }
    },
    {
      "id": "R9-004",
      "requirements": ["R9", "R6"],
      "title": "The cap is applied before jitter, so the result can never exceed it",
      "kind": "backoff",
      "input": { "attempt": 20, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "full" }, "random": 0.999 },
      "expect": { "delayMs": 29970 }
    },
    {
      "id": "R9-005",
      "requirements": ["R9"],
      "title": "Equal jitter keeps a floor at half the computed delay",
      "kind": "backoff",
      "input": { "attempt": 1, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "equal" }, "random": 0 },
      "expect": { "delayMs": 500 }
    },
    {
      "id": "R9-006",
      "requirements": ["R9"],
      "title": "Equal jitter spreads across the upper half",
      "kind": "backoff",
      "input": { "attempt": 1, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "equal" }, "random": 0.5 },
      "expect": { "delayMs": 750 }
    },
    {
      "id": "R9-007",
      "requirements": ["R9"],
      "title": "Full jitter can return anywhere in the range, including near zero",
      "kind": "backoff",
      "input": { "attempt": 1, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "full" }, "random": 0 },
      "expect": { "delayMs": 0 }
    },
    {
      "id": "R9-008",
      "requirements": ["R9"],
      "title": "Full jitter scales linearly with the random draw",
      "kind": "backoff",
      "input": { "attempt": 2, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "full" }, "random": 0.25 },
      "expect": { "delayMs": 500 }
    },
    {
      "id": "R9-009",
      "requirements": ["R9"],
      "title": "A misbehaving random source cannot push the delay out of bounds",
      "kind": "backoff",
      "input": { "attempt": 1, "config": { "baseMs": 1000, "factor": 2, "maxMs": 30000, "jitter": "full" }, "random": 5 },
      "expect": { "delayMs": 1000 }
    },
    {
      "id": "R9-010",
      "requirements": ["R9"],
      "title": "A non-idempotent request is not replayed, and the limit is surfaced unchanged",
      "kind": "scenario",
      "input": {
        "config": { "maxRetries": 3, "maxWaitMs": 600000 },
        "startTimeMs": 0,
        "request": { "url": "/repos/o/r/issues", "method": "POST" },
        "responses": [
          {
            "throwStatus": 403,
            "headers": { "x-ratelimit-remaining": "0", "x-ratelimit-reset": "60", "x-ratelimit-limit": "5000" }
          }
        ]
      },
      "expect": {
        "outcome": "rate-limit",
        "attempts": 1,
        "sleeps": [],
        "error": { "kind": "primary", "retried": false, "exceededWaitCeiling": false }
      }
    },
    {
      "id": "R9-011",
      "requirements": ["R9", "R12"],
      "title": "A non-idempotent request is replayed when the consumer opts in",
      "kind": "scenario",
      "input": {
        "config": {
          "maxRetries": 1,
          "maxWaitMs": 600000,
          "retryNonIdempotent": true,
          "backoff": { "jitter": "none", "baseMs": 0 }
        },
        "startTimeMs": 0,
        "request": { "url": "/repos/o/r/issues", "method": "POST" },
        "responses": [
          {
            "throwStatus": 403,
            "headers": { "x-ratelimit-remaining": "0", "x-ratelimit-reset": "60", "x-ratelimit-limit": "5000" }
          },
          {
            "status": 201,
            "headers": { "x-ratelimit-remaining": "4999", "x-ratelimit-reset": "3660", "x-ratelimit-limit": "5000" }
          }
        ]
      },
      "expect": { "outcome": "success", "attempts": 2, "sleeps": [61000] }
    },
    {
      "id": "R9-012",
      "requirements": ["R9", "R11"],
      "title": "When retries run out the underlying rate limit is surfaced, with the attempt count",
      "kind": "scenario",
      "input": {
        "config": {
          "maxRetries": 2,
          "maxWaitMs": 600000,
          "backoff": { "jitter": "none", "baseMs": 0 }
        },
        "startTimeMs": 0,
        "request": { "url": "/repos/o/r", "method": "GET" },
        "responses": [
          { "throwStatus": 429, "headers": { "retry-after": "1" } },
          { "throwStatus": 429, "headers": { "retry-after": "1" } },
          { "throwStatus": 429, "headers": { "retry-after": "1" } }
        ]
      },
      "expect": {
        "outcome": "rate-limit",
        "attempts": 3,
        "error": { "kind": "secondary", "retried": true, "exceededWaitCeiling": false }
      }
    }
  ]
}
