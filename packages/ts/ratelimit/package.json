{
  "name": "@internal/github-sdk-ratelimit",
  "version": "0.0.1",
  "description": "GitHub rate limiting — tracking, classification, pacing, concurrency and bounded waiting.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./conformance": {
      "import": {
        "types": "./dist/esm/conformance/index.d.ts",
        "default": "./dist/esm/conformance/index.js"
      },
      "require": {
        "types": "./dist/cjs/conformance/index.d.ts",
        "default": "./dist/cjs/conformance/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --module NodeNext --moduleResolution NodeNext --outDir dist/esm && tsc -p tsconfig.build.json --module CommonJS --moduleResolution Node10 --outDir dist/cjs && node ../scripts/fixup-dist.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "github",
    "api",
    "rate-limit",
    "throttle",
    "backoff",
    "concurrency",
    "sdk"
  ],
  "author": "GitHub API Module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {},
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
