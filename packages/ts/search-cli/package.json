{
  "name": "github-search-wizard",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive @clack/prompts wizard over the GitHub Search API",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "github-search-wizard": "./dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && node ../scripts/gen-version.mjs . && tsc -p tsconfig.build.json --module NodeNext --moduleResolution NodeNext --outDir dist/esm && tsc -p tsconfig.build.cjs.json --module CommonJS --moduleResolution Node10 --outDir dist/cjs && node ../scripts/fixup-dist.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:live": "GITHUB_LIVE=1 vitest run -c vitest.live.config.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@clack/prompts": "0.7.0",
    "chalk": "5.3.0",
    "dotenv": "^16.4.1",
    "@internal/github-sdk-search": "^0.0.1",
    "@internal/github-sdk-ratelimit": "^0.0.1",
    "@internal/github-sdk-fetch-rest-api": "^0.0.1",
    "@internal/github-sdk-fetch-proxy": "^0.0.1"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
