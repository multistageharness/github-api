{
  "name": "@internal/github-sdk-fetch-github-sdk",
  "version": "0.0.1",
  "description": "The SDK facade composing the REST and GraphQL transports — one token, one limiter, one transport, both APIs. The role @octokit/core plays in octokit.js (PRD 0002, R13).",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --module NodeNext --moduleResolution NodeNext --outDir dist/esm && tsc -p tsconfig.build.json --module CommonJS --moduleResolution Node10 --outDir dist/cjs && node ../scripts/fixup-dist.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "github",
    "api",
    "sdk",
    "fetch",
    "graphql",
    "rest"
  ],
  "author": "GitHub API Module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@internal/github-sdk-fetch-graphql-api": "^0.0.1",
    "@internal/github-sdk-fetch-rest-api": "^0.0.1",
    "@internal/github-sdk-ratelimit": "^0.0.1"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
