{
  "name": "@internal/github-sdk-search",
  "version": "0.0.1",
  "description": "Enterprise-grade GitHub Search API client with scalability features (TypeScript)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "github-search": "./dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/esm/lib/SafeSearchClient.d.ts",
        "default": "./dist/esm/lib/SafeSearchClient.js"
      },
      "require": {
        "types": "./dist/cjs/lib/SafeSearchClient.d.ts",
        "default": "./dist/cjs/lib/SafeSearchClient.js"
      }
    },
    "./endpoints": {
      "import": {
        "types": "./dist/esm/endpoints/index.d.ts",
        "default": "./dist/esm/endpoints/index.js"
      },
      "require": {
        "types": "./dist/cjs/endpoints/index.d.ts",
        "default": "./dist/cjs/endpoints/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/utils/index.d.ts",
        "default": "./dist/esm/utils/index.js"
      },
      "require": {
        "types": "./dist/cjs/utils/index.d.ts",
        "default": "./dist/cjs/utils/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json",
    "build": "rm -rf dist && node ../scripts/gen-version.mjs . && tsc -p tsconfig.build.json --module NodeNext --moduleResolution NodeNext --outDir dist/esm && tsc -p tsconfig.build.json --module CommonJS --moduleResolution Node10 --outDir dist/cjs && node ../scripts/fixup-dist.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "github",
    "search",
    "api",
    "cli",
    "sdk",
    "enterprise",
    "scalable",
    "rate-limiting",
    "caching"
  ],
  "author": "GitHub Search API Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@internal/github-sdk-fetch-proxy": "^0.0.1",
    "@internal/github-sdk-fetch-rest-api": "^0.0.1",
    "@internal/github-sdk-ratelimit": "^0.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.1",
    "ora": "^8.0.1"
  },
  "optionalDependencies": {
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/sdk-node": "^0.46.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
