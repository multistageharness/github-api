{
  "name": "@internal/github-sdk-activity",
  "version": "0.0.1",
  "description": "GitHub Activity API SDK and CLI - Complete implementation for events, notifications, stars, and watching (TypeScript)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "github-activity": "./dist/esm/bin/github-activity.js",
    "gha": "./dist/esm/bin/github-activity.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/esm/client/ActivityClient.d.ts",
        "default": "./dist/esm/client/ActivityClient.js"
      },
      "require": {
        "types": "./dist/cjs/client/ActivityClient.d.ts",
        "default": "./dist/cjs/client/ActivityClient.js"
      }
    },
    "./models": {
      "import": {
        "types": "./dist/esm/models/types.d.ts",
        "default": "./dist/esm/models/types.js"
      },
      "require": {
        "types": "./dist/cjs/models/types.d.ts",
        "default": "./dist/cjs/models/types.js"
      }
    },
    "./api/events": {
      "import": {
        "types": "./dist/esm/api/events.d.ts",
        "default": "./dist/esm/api/events.js"
      },
      "require": {
        "types": "./dist/cjs/api/events.d.ts",
        "default": "./dist/cjs/api/events.js"
      }
    },
    "./api/notifications": {
      "import": {
        "types": "./dist/esm/api/notifications.d.ts",
        "default": "./dist/esm/api/notifications.js"
      },
      "require": {
        "types": "./dist/cjs/api/notifications.d.ts",
        "default": "./dist/cjs/api/notifications.js"
      }
    },
    "./api/feeds": {
      "import": {
        "types": "./dist/esm/api/feeds.d.ts",
        "default": "./dist/esm/api/feeds.js"
      },
      "require": {
        "types": "./dist/cjs/api/feeds.d.ts",
        "default": "./dist/cjs/api/feeds.js"
      }
    },
    "./api/stars": {
      "import": {
        "types": "./dist/esm/api/stars.d.ts",
        "default": "./dist/esm/api/stars.js"
      },
      "require": {
        "types": "./dist/cjs/api/stars.d.ts",
        "default": "./dist/cjs/api/stars.js"
      }
    },
    "./api/watching": {
      "import": {
        "types": "./dist/esm/api/watching.d.ts",
        "default": "./dist/esm/api/watching.js"
      },
      "require": {
        "types": "./dist/cjs/api/watching.d.ts",
        "default": "./dist/cjs/api/watching.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json",
    "build": "rm -rf dist && node ../scripts/gen-version.mjs . && tsc -p tsconfig.build.json --module NodeNext --moduleResolution NodeNext --outDir dist/esm && tsc -p tsconfig.build.json --module CommonJS --moduleResolution Node10 --outDir dist/cjs && node ../scripts/fixup-dist.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "github",
    "api",
    "activity",
    "events",
    "notifications",
    "stars",
    "cli",
    "sdk",
    "rest"
  ],
  "author": "GitHub",
  "license": "MIT",
  "dependencies": {
    "@internal/github-sdk-fetch-proxy": "^0.0.1",
    "@internal/github-sdk-fetch-rest-api": "^0.0.1",
    "@internal/github-sdk-ratelimit": "^0.0.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.0",
    "ora": "^7.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
