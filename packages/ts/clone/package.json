{
  "name": "@internal/github-sdk-clone",
  "version": "1.0.1",
  "description": "Git Repository Management SDK and CLI - Local git operations with simple-git (TypeScript)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "gh-clone": "./dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/esm/client/GitClient.d.ts",
        "default": "./dist/esm/client/GitClient.js"
      },
      "require": {
        "types": "./dist/cjs/client/GitClient.d.ts",
        "default": "./dist/cjs/client/GitClient.js"
      }
    },
    "./progress": {
      "import": {
        "types": "./dist/esm/utils/progress.d.ts",
        "default": "./dist/esm/utils/progress.js"
      },
      "require": {
        "types": "./dist/cjs/utils/progress.d.ts",
        "default": "./dist/cjs/utils/progress.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/esm/types/index.js"
      },
      "require": {
        "types": "./dist/cjs/types/index.d.ts",
        "default": "./dist/cjs/types/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples:typecheck": "tsc -p examples/tsconfig.json",
    "build": "rm -rf dist && node ../scripts/gen-version.mjs . && tsc -p tsconfig.build.json --module NodeNext --moduleResolution NodeNext --outDir dist/esm && tsc -p tsconfig.build.json --module CommonJS --moduleResolution Node10 --outDir dist/cjs && node ../scripts/fixup-dist.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "git",
    "clone",
    "pull",
    "push",
    "repository",
    "management",
    "cli",
    "sdk",
    "simple-git",
    "github",
    "local"
  ],
  "author": "GitHub API Module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@internal/github-sdk-fetch-proxy": "^0.0.1",
    "@internal/cli-progressor": "^1.0.3",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.10",
    "ora": "^7.0.1",
    "simple-git": "^3.19.1",
    "yaml": "^2.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
